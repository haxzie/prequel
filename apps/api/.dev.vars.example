# Copy to apps/api/.dev.vars, which is gitignored. Wrangler loads it for
# `wrangler dev` and for the tests; the deployed Worker gets these through
# `wrangler secret put <NAME> --env production` instead.
#
# The non-secret configuration — APP_URL, API_URL, the waitlist form, the SES
# region and sender — is in wrangler.jsonc, not here.

BETTER_AUTH_SECRET=

# Redirect URI to register: http://localhost:8787/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# R2's S3 credentials, which are not the bucket binding. The binding can read
# and write objects; only these can sign a URL for the desktop app to PUT to or
# for a visitor's browser to GET from, which is the whole upload and playback
# path.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=prequel-media

# An IAM user with ses:SendEmail. The sender in wrangler.jsonc must be verified,
# and while the account is in the SES sandbox every recipient must be too — an
# unverified address fails with a message about the sender, which is misleading.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# Without it /v1/transcribe answers 503 and the editor reports that
# transcription is unavailable, which is the intended behaviour rather than a
# broken deployment.
OPENAI_API_KEY=

# Dodo Payments. The product and brand ids are not secret and live in
# wrangler.jsonc; these two are.
#
# The webhook key is the `whsec_…` signing key under Developer → Webhooks, not
# the API key. Without it the webhook route refuses every call, which is
# deliberate — an unsigned POST to it could set any team's plan.
DODOPAYMENT_API_KEY=
DODOPAYMENT_WEBHOOK_SECRET=

# The two product ids, overriding the empty defaults in wrangler.jsonc. Set them
# to the ids from Dodo's **test** dashboard: the mode there is `test`, and a
# live product id sent to the test host is a 404 that reads as a broken
# integration. The live ids are in the production block of wrangler.jsonc.
#
# The lifetime one is read by the webhook as well as by checkout, and that is
# the half that matters — `payment.succeeded` fires for subscription renewals
# too, and this id is what tells the two apart. Leave it empty and the handler
# throws rather than guessing.
DODOPAYMENT_BRAND_ID=
DODOPAYMENT_PRO_PRODUCT_ID=
DODOPAYMENT_LIFETIME_PRODUCT_ID=
