{
  "name": "@prequel/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types scripts/check-ffmpeg-core.ts && next dev --port 3000",
    "build": "node --experimental-strip-types scripts/check-ffmpeg-core.ts && next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "cf:build": "NEXT_PUBLIC_APP_URL=https://prequel.sh NEXT_PUBLIC_API_URL=https://api.prequel.sh opennextjs-cloudflare build",
    "cf:preview": "NEXT_PUBLIC_APP_URL=https://prequel.sh NEXT_PUBLIC_API_URL=https://api.prequel.sh opennextjs-cloudflare preview",
    "cf:deploy": "NEXT_PUBLIC_APP_URL=https://prequel.sh NEXT_PUBLIC_API_URL=https://api.prequel.sh opennextjs-cloudflare deploy",
    "ffmpeg": "node --experimental-strip-types scripts/upload-ffmpeg.ts",
    "clean": "rm -rf .next .turbo node_modules *.tsbuildinfo"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.0",
    "@next/third-parties": "^16.3.3",
    "@prequel/env": "workspace:*",
    "better-auth": "^1.7.1",
    "boring-avatars": "^2.0.4",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "posthog-js": "^1.418.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@opennextjs/cloudflare": "^1.20.18",
    "@prequel/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "aws4fetch": "^1.0.20",
    "react-grab": "^0.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.125.0"
  }
}
