{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "envMode": "loose",
  "globalDependencies": [".env", "packages/typescript-config/*.json", "Cargo.lock"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "src/**/*.rs", "Cargo.toml", "build.rs"],
      // Deliberately no `release/**`. That directory holds the packaged
      // artefacts — a 100 MB disk image and a 109 MB zip per version, kept
      // rather than cleaned — so caching it tars every build that came before
      // it too. It reached 18 GB across 1,824 entries before this was noticed.
      // Nothing downstream reads a packaged installer, and `pnpm ship` calls
      // the filter directly rather than going through turbo, so there is
      // nothing to restore it for.
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "out/**",
        "*.node",
        "index.js",
        "index.d.ts"
      ]
    },
    // Packaging builds what it packages.
    //
    // Without this the task is outside the graph entirely, so `electron-builder`
    // copies whatever `.node` happens to be sitting in `packages/recorder` —
    // which after a change to `crates/` is the previous one. The app installs,
    // launches, previews correctly, and exports through a compositor built
    // before the change, with nothing anywhere saying so.
    //
    // Uncached on purpose: the output is a signed disk image, and the note on
    // `build`'s `outputs` above covers why those are not worth keeping.
    "package": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
