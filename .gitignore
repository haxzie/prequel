# Build output that lands at the repo root. Nothing imports it — the desktop
# entry point is apps/desktop/out/main/index.js — and it is rewritten by every
# package build, so a committed copy is stale the moment it exists. A tracked
# apps/desktop/index.js from an earlier build was exactly this.
/index.js
/index.d.ts
