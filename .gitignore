node_modules/
.pnpm-store/

# Build output
dist/
out/
release/
.next/
*.tsbuildinfo

# Rust
target/

# napi-rs generated bindings (rebuilt by `pnpm build`)
packages/recorder/*.node
packages/recorder/index.js
packages/recorder/index.d.ts

# Turbo
.turbo/

# Env
.env
.env.*
!.env.example

# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# Wrangler secrets for local `wrangler dev`. The example beside it is committed.
.dev.vars
.wrangler/

# Build output that lands at the repo root. Nothing imports it — the desktop
# entry point is apps/desktop/out/main/index.js — and it is rewritten by every
# package build, so a committed copy is stale the moment it exists. A tracked
# apps/desktop/index.js from an earlier build was exactly this.
/index.js
/index.d.ts

# Generated by `scripts/sync-backgrounds.mjs` from the `backgrounds/` folder at
# the repo root, which is the one committed copy of these pictures.
apps/desktop/resources/backgrounds/

# The Cloudflare build: `next build` output transformed into a Worker and its
# assets by `@opennextjs/cloudflare`. Produced by `pnpm --filter @prequel/web
# cf:build`, holds a copy of every prerendered page, and is rebuilt on every
# deploy — there is nothing in it that is not derived from the tree.
apps/web/.open-next/

# Wrangler's local account cache, written beside whichever command ran.
.cloudflare/

# Left over from when the converter's ffmpeg core was copied into the site.
# It is fetched from R2 now — see apps/web/src/lib/free-tools/ffmpeg-core.ts —
# and nothing writes this any more. Still ignored because a tree that built the
# old way still holds 30MB of WebAssembly here, and a binary committed by
# accident is in git for ever.
apps/web/public/ffmpeg/
