# Copy to .env (`pnpm install` does this automatically if .env is missing).
# Every variable here must also be declared in packages/env/src/env.ts —
# anything undeclared is invisible to the apps.

# --- server-only ------------------------------------------------------------
# NODE_ENV is set by the tooling (next/electron-vite) — don't pin it here.
#
# There is nothing else here on purpose. Every API — auth, the library, uploads,
# transcription, the waitlist — is the Cloudflare Worker in apps/api, which takes
# its configuration from wrangler rather than from this file. See the Worker
# section further down.

# --- exposed to the browser / renderer (NEXT_PUBLIC_ prefix) ----------------
NEXT_PUBLIC_APP_NAME=Prequel
# Pinned to localhost for local work. The schema defaults to https://prequel.sh,
# which is what a deploy gets when nothing sets this — canonicals, the sitemap,
# both share cards and every /v/<slug> link the Worker hands back come off it.
#
# Packaging the desktop app bakes this value in, so a .dmg built with the line
# below is a .dmg that opens localhost when somebody signs in. Set it to the
# deployed origin first.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The API. `wrangler dev` serves it on 8787; production is api.prequel.sh.
#
# It must stay inside prequel.sh in production. The session cookie is scoped to
# the registrable domain, and an API on some other origin would never be sent it
# — which presents as a dashboard that is signed out immediately after signing in.
#
# Baked into the .dmg the same way as the line above: this is where the desktop
# app sends transcriptions, sign-ins and uploads.
NEXT_PUBLIC_API_URL=http://localhost:8787

# PostHog. The project token is public — write-only, and served to every browser
# that loads the site — so it is checked in rather than kept in .dev.vars.
#
# The same token is used while developing. Every event carries an `environment`
# property, so local traffic is filterable in PostHog rather than absent, and the
# integration is exercised before it reaches production rather than after.
#
# apps/web reads these two directly. The desktop app reads neither: it posts to
# the Worker's /v1/events and the Worker holds the token, which is what keeps it
# out of the .dmg and makes analytics reroutable without shipping a build.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_A4dtr8QH5LNujAGCTu9SANWvJLt6HUN5whqwsu3fGohc
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics 4. Public, fixed for the life of the property, and defaulted
# to the real id in packages/env/src/env.ts — so unlike the PostHog token there
# is nothing to set here or on the deployment.
#
# Left commented for that reason. The tag is only rendered when
# NEXT_PUBLIC_APP_URL is https, so the line above keeps local pageviews out of
# the property; uncommenting this changes nothing on its own.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-V0CDLY5XCP

# --- the API Worker (apps/api) ----------------------------------------------
# Read by wrangler, not by the apps, so like the signing credentials below these
# are deliberately *not* declared in packages/env/src/env.ts. A Worker is handed
# its configuration through bindings; there is no process.env for it to read.
#
# Non-secret values (APP_URL, API_URL, the waitlist form, the SES region and
# sender, and POSTHOG_PROJECT_TOKEN / POSTHOG_HOST) live in
# apps/api/wrangler.jsonc. The secrets below go in
# apps/api/.dev.vars for local work — copy apps/api/.dev.vars.example — and are
# set on the deployment with:
#
#     wrangler secret put BETTER_AUTH_SECRET --env production
#
#   BETTER_AUTH_SECRET      openssl rand -base64 32
#   GOOGLE_CLIENT_ID        Google Cloud console → Credentials → OAuth client
#   GOOGLE_CLIENT_SECRET    the redirect URI is <API_URL>/api/auth/callback/google
#   R2_ACCOUNT_ID           Cloudflare dashboard → R2 → Account details
#   R2_ACCESS_KEY_ID        R2 → Manage API tokens. NOT the bucket binding: a
#   R2_SECRET_ACCESS_KEY    binding cannot sign a URL for a client to use.
#   R2_BUCKET               prequel — must match `bucket_name` in wrangler.jsonc
#   SES_ACCESS_KEY_ID       an IAM user with ses:SendEmail
#   SES_SECRET_ACCESS_KEY   the sender address must be verified in SES, and a
#                           sandboxed account can only send to verified ones
#   OPENAI_API_KEY          without it /v1/transcribe answers 503 and the editor
#                           reports that transcription is unavailable
#   GITHUB_TOKEN            optional, and only for /v1/updates/notes. Public data
#                           either way; it raises GitHub's 60-per-hour limit for
#                           an unauthenticated address, which a Worker shares
#                           with the rest of Cloudflare. The update download path
#                           never calls the API and needs no token.

# --- macOS signing and notarisation ----------------------------------------
# Read by electron-builder, not by the apps, so these are the exception to the
# rule at the top of this file: they are deliberately *not* declared in
# packages/env/src/env.ts. Nothing at runtime should be able to see a signing
# credential.
#
# The names are electron-builder's own, and the GitHub secrets use the same ones,
# so this section doubles as the list of what `gh secret set` needs.
#
#     pnpm ship        # builds with these loaded, then installs
#
# Without them the build is unsigned, which is fine for checking a change and not
# something to hand to anyone — macOS quarantines it on any machine but this one.

# Notarisation, via an App Store Connect API key: App Store Connect → Users and
# Access → Integrations → App Store Connect API, with the **Developer** role. The
# `.p8` downloads exactly once and cannot be fetched again.
#
# Signed but not notarised, Gatekeeper says "Unnotarized Developer ID" and the
# user sees "Prequel is damaged and can't be opened" — which reads as corruption
# rather than as a warning, so this is not optional for anything published.
#
# A path to the `.p8`, not its contents. In CI the secret is APPLE_API_KEY_BASE64
# instead, which the workflow decodes to a file and points this at.
# APPLE_API_KEY=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
# APPLE_API_KEY_ID=XXXXXXXXXX
# APPLE_API_ISSUER=00000000-0000-0000-0000-000000000000

# The Developer ID Application certificate, needed only where it is not already
# in the keychain — which means CI. On the machine that made the CSR,
# electron-builder finds the identity itself; check with
# `security find-identity -v -p codesigning`.
#
# A path to the `.p12` locally, or its base64 in CI; electron-builder takes
# either. It must be a *Developer ID Application* certificate — an Apple
# Distribution one is for the App Store, and signs happily while Gatekeeper still
# refuses the download.
# CSC_LINK=
# CSC_KEY_PASSWORD=
