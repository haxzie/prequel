# Copy to .env (`pnpm install` does this automatically if .env is missing).
# Every variable here must also be declared in packages/env/src/env.ts —
# anything undeclared is invisible to the apps.

# --- server-only ------------------------------------------------------------
# NODE_ENV is set by the tooling (next/electron-vite) — don't pin it here.
# DATABASE_URL=postgres://user:pass@localhost:5432/prequel
# API_SECRET=

# --- exposed to the browser / renderer (NEXT_PUBLIC_ prefix) ----------------
NEXT_PUBLIC_APP_NAME=Prequel
NEXT_PUBLIC_APP_URL=http://localhost:3000
